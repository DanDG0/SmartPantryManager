<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="wrap_content"
    android:orientation="vertical" android:padding="14dp"
    android:layout_marginBottom="6dp" android:background="#E8F5E9">
    <TextView android:id="@+id/tvRecipeName" android:layout_width="wrap_content"
        android:layout_height="wrap_content" android:textSize="18sp" android:textStyle="bold"/>
    <TextView android:id="@+id/tvIngredientCount" android:layout_width="wrap_content"
        android:layout_height="wrap_content" android:textSize="14sp"/>
</LinearLayout>
