<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:orientation="vertical" android:padding="16dp">

    <EditText android:id="@+id/etName" android:layout_width="match_parent"
        android:layout_height="wrap_content" android:hint="Ingredient name (e.g. tomato)"
        android:inputType="textCapWords"/>

    <EditText android:id="@+id/etQuantity" android:layout_width="match_parent"
        android:layout_height="wrap_content" android:hint="Quantity"
        android:inputType="numberDecimal"/>

    <Spinner android:id="@+id/spUnit" android:layout_width="match_parent"
        android:layout_height="wrap_content" android:layout_marginTop="8dp"/>

    <EditText android:id="@+id/etExpiry" android:layout_width="match_parent"
        android:layout_height="wrap_content" android:hint="Expiry date yyyy-MM-dd (optional)"
        android:inputType="date"/>

    <Button android:id="@+id/btnSave" android:layout_width="match_parent"
        android:layout_height="wrap_content" android:layout_marginTop="16dp" android:text="Save"/>
</LinearLayout>
